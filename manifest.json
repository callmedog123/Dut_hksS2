{
  "manifest_version": 3,
  "name": "The Unclicked（余路）",
  "description": "A local-first prototype for revisiting seriously considered search paths.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://search.bilibili.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://search.bilibili.com/*"
      ],
      "js": [
        "content/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/bilibiliRuntime.js",
        "content/adapters/bilibiliSearchAdapter.js",
        "content/candidateBinding.js",
        "content/eventCollector/click.js",
        "content/eventCollector/hover.js",
        "content/visibility.js",
        "shared/messages.js",
        "shared/types.js",
        "shared/url.js"
      ],
      "matches": [
        "https://search.bilibili.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "Open The Unclicked"
  }
}
